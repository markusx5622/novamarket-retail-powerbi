# Archivos temporales de Office
# ===============================
~$*
~$*.docx
~$*.xlsx
~$*.pptx

# ===============================
# Sistema operativo
# ===============================
.DS_Store
Thumbs.db
desktop.ini
Desktop.ini

# ===============================
# Editores / IDE
# ===============================
.vscode/
.idea/
*.swp
*.swo

# ===============================
# Reglas de inclusión explícita
# (estos tipos de archivo NUNCA deben ignorarse)
# ===============================
