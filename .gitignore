# ===============================
# Python – bytecode y caché
# ===============================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# ===============================
# Entornos virtuales
# ===============================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ===============================
# Herramientas de calidad y caché
# ===============================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ===============================
# Notebooks Jupyter
# ===============================
*.ipynb
.ipynb_checkpoints/

# ===============================
# Power BI – caché local y temporales
# ===============================
*.pbix.autosave
*.tmp
*.bak
*.laccdb
*.ldb
*/.pbi/cache/**
*/.pbi/localSettings.json
*/.pbi/mashup.cache
.pbicache/

